# Proton server to peer with. Pick from the host's freehop logicals.json.
# Fill these in from your own host: the values below are placeholders.
PROTON_DOMAIN=node-mx-14.protonvpn.net
PROTON_ENTRY_IP=203.0.113.10
PROTON_PUBKEY=REPLACE_WITH_PROTON_PEER_PUBLIC_KEY_BASE64=

# Absolute paths to credentials produced by the official Proton VPN client
# and freehop on the host. Mounted read-only; never copied into the image.
# Use the home directory of the machine that owns the credentials, for
# example /home/your-user/.config/Proton/keyring-proton-sso-account-<account-id>.json
KEYRING_FILE=/home/your-user/.config/Proton/keyring-proton-sso-account-<account-id>.json
CERT_FILE=/home/your-user/.local/share/freehop/cert.json
WG_PRIVATE_KEY=/home/your-user/.local/share/freehop/wg-private.key
